FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      Ydefault;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];
internalField   uniform 0.233;
boundaryField
{
    burner
    {
        type            fixedValue;
        value           uniform 1.0;
    }
    ambient { type fixedValue; value uniform 0.233; }
}
