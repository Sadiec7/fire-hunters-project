FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];
internalField   uniform 98000.0;
boundaryField
{
    burner { type zeroGradient; }
    ambient { type fixedValue; value uniform 98000.0; }
}
