FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     reactingFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         1.2;
deltaT          1e-4;
writeControl    adjustableRunTime;
writeInterval   0.1;
